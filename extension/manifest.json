{
  "manifest_version": 3,
  "name": "Orbit Link Bridge",
  "description": "Send direct file links from your browser to Orbit Download on Android.",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to Orbit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/orbit-16.png",
      "32": "icons/orbit-32.png",
      "48": "icons/orbit-48.png",
      "128": "icons/orbit-128.png"
    }
  },
  "icons": {
    "16": "icons/orbit-16.png",
    "32": "icons/orbit-32.png",
    "48": "icons/orbit-48.png",
    "128": "icons/orbit-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "102"
}