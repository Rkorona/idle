{
  "manifest_version": 3,
  "name": "Orbit Link Bridge",
  "description": "Send direct file links from your browser to Orbit Download on Android.",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Send to Orbit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/orbit-16.png",
      "32": "icons/orbit-32.png",
      "48": "icons/orbit-48.png",
      "128": "icons/orbit-128.png"
    }
  },
  "icons": {
    "16": "icons/orbit-16.png",
    "32": "icons/orbit-32.png",
    "48": "icons/orbit-48.png",
    "128": "icons/orbit-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "orbit-link-bridge@myapp.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  }
}